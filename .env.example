# ai-hub (旧 ai-watch) 用環境変数テンプレート。このファイルをコピーして .env として使う。
# cp .env.example .env

# Claude API (要約生成用)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Supabase (ai_watch.articles 差分保存先)
# SERVICE_ROLE キーは https://supabase.com/dashboard/project/zrawhzwtppmlxyhngnju/settings/api-keys
# の「service_role」(secret) をコピーして貼り付ける
SUPABASE_URL=https://zrawhzwtppmlxyhngnju.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Shopify Admin API (admin/server.py の /admin Shopify タブで使用)
# 取得手順: Shopify管理画面 → 設定 → アプリと販売チャネル → アプリ開発
#  → カスタムアプリ作成 → Admin APIアクセストークン
# 必要スコープ: read_products, read_orders, read_inventory, read_customers
# (在庫更新もしたい場合は write_inventory / write_products も追加)
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_STORE_DOMAIN=84c617.myshopify.com
# SHOPIFY_API_VERSION=2024-10

# ===== クラウド管理画面 (/admin on Vercel) 用 =====
# Vercel ダッシュボードか scripts/setup_admin_env.sh で登録する。
# ローカルで動かす場合のみ .env にも書く（Vercel 本番には反映されない）。

# 管理画面ログイン（ユーザー名なし・パスワードのみ）
ADMIN_PASS=...強いパスワード...
# ADMIN_SESSION_SECRET=...random-64-chars...

# カラーミー OAuth アクセストークン
# colorme setup で取得した token を貼る
COLORME_ACCESS_TOKEN=...
# テンプレ ID。デフォルト値で OK のはずだが念のため明示可
COLORME_PREVIEW_TEMPLATE_ID=1086
COLORME_LIVE_TEMPLATE_ID=1064
# 公開後の「完成URL」表示に使うショップ URL（末尾スラッシュなし）
# COLORME_SHOP_URL=https://goodbouldering.com

# OpenAI (DALL-E 3 画像生成)
OPENAI_API_KEY=sk-...

# Supabase Storage バケット名 (ai-hub-public は public=true で作成済)
SUPABASE_BUCKET=ai-hub-public

# ===== Stripe Checkout =====
# 共通のサーバー秘密鍵。ブラウザや公開HTMLへ絶対に埋め込まない。
STRIPE_SECRET_KEY=sk_test_...
# Stripe Dashboardで作成したWebhook署名シークレット。
STRIPE_WEBHOOK_SECRET=whsec_...
# AI伴走支援（月額10万円）のrecurring Price ID。
STRIPE_MONTHLY_SUPPORT_PRICE_ID=price_...
STRIPE_SUPPORT_TERM_MONTHS=6
# AIオンラインサロンのrecurring Price ID。金額・解約条件を確定後に作成する。
STRIPE_AI_SALON_PRICE_ID=price_...
# 決済確認済みページだけが読む、ローテーション後のLINE招待URL。
AI_SALON_LINE_INVITE_URL=https://line.me/ti/g2/...
# LINE公式アカウントの「メンバーシップ限定オープンチャット」参加URL。
# 通常のオープンチャットでは加入・退会をAPIで自動管理できないため、
# 自動管理する本番導線ではこちらを設定する。
AI_SALON_LINE_MEMBERSHIP_URL=https://line.me/R/...
# Checkoutの戻り先に使う公開URL。
AIHUB_SITE_URL=https://ai-hub-jp.vercel.app

# ===== SNS 一括投稿 MVP (Phase 2) =====
# X (Twitter) — developer.twitter.com で取得
# 取得手順: https://developer.twitter.com/en/portal/dashboard
#   → Create App → Keys and Tokens → Consumer Keys + Access Tokens and Secrets
# 必要 OAuth 1.0a スコープ: tweet.write tweet.read users.read
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# Threads — developers.facebook.com で取得
# 取得手順: Meta for Developers → Threads API
#   → アプリを作成 → Threads API を追加 → ユーザーアクセストークンを生成
# THREADS_USER_ID: Threads のユーザー数値 ID（プロフィールから取得）
# THREADS_ACCESS_TOKEN: 長期アクセストークン（60日更新 or 無期限トークン）
THREADS_USER_ID=your_threads_user_id_here
THREADS_ACCESS_TOKEN=your_threads_access_token_here

# Square API / MCP
# Square Developer Dashboard で取得。実トークンは .env または Vercel env にだけ保存する。
SQUARE_ACCESS_TOKEN=sq0atp_your_square_access_token_here
SQUARE_ENVIRONMENT=production
SQUARE_VERSION=2026-05-20
SQUARE_LOCATION_ID=LWJNMP7EAN4GS
SQUARE_BOOKING_SERVICE_ID=TO3XHZT6XP3OM4QBDYMW7TZP
