{
  "name": "aiclimb",
  "main": "../.glass-release/runtime/worker/public-entry.mjs",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "ratelimits": [
    {
      "name": "ADMIN_LOGIN_LIMITER",
      "namespace_id": "2026090802",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "../.glass-release/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/health",
      "/api",
      "/api/*",
      "/admin",
      "/admin/*",
      "/ops",
      "/ops/*",
      "/watch",
      "/watch/*",
      "/lectures/2026-05-claude-code-features.html",
      "/media/ai-consult-hikone-20260629/ai-consult-hikone-course.webm"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "no_bundle": false,
  "find_additional_modules": false,
  "alias": {
    "sanitize-html": "../deployment/profile/node_modules/sanitize-html/index.js"
  }
}
