{
  "name": "ai-hub-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bridge": "node bridge/bridge.mjs",
    "bridge:test": "node --test bridge/bridge.test.mjs",
    "test:market-compass": "node scripts/run-market-compass-tests.mjs",
    "cloudflare:types": "wrangler types worker/worker-configuration.d.ts",
    "cloudflare:test": "vitest run worker/index.test.ts && node --test worker/static-output.test.mjs",
    "cloudflare:check": "npm run cloudflare:types && tsc -p worker/tsconfig.json && npm run cloudflare:test",
    "cloudflare:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@supabase/supabase-js": "^2.45.0",
    "gray-matter": "^4.0.3",
    "iconv-lite": "^0.6.3",
    "marked": "^14.1.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@types/node": "^20.12.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.127.1"
  }
}
