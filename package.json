{
  "name": "ai-sodan-hikone",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:portal": "node scripts/prepare_sites_public.mjs --build",
    "sites:prepare": "node scripts/prepare_sites_public.mjs",
    "build": "npm run build:portal && vinext build",
    "dev": "npm run sites:prepare && vinext dev",
    "start": "vinext start",
    "test:sites": "node --test tests/prepare_sites_public.test.mjs tests/rendered-salon.test.mjs",
    "test:worker": "node --test tests/worker-routing.test.mjs",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@supabase/supabase-js": "^2.45.0",
    "gray-matter": "^4.0.3",
    "iconv-lite": "^0.6.3",
    "marked": "^14.1.3",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
