{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@5.1.6",
      "maxDuration": 60,
      "includeFiles": "{site/static/admin/**,site/static/ops/**,content/consul-work/**,outputs/agents_status.json,supabase/migrations/**}"
    }
  },
  "redirects": [
    { "source": "/admin/docs", "destination": "/ops", "permanent": false },
    { "source": "/admin/docs/", "destination": "/ops", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin/login", "destination": "/api/admin/login" },
    { "source": "/admin/login/", "destination": "/api/admin/login" },
    { "source": "/admin/logout", "destination": "/api/admin/logout" },
    { "source": "/admin/logout/", "destination": "/api/admin/logout" },
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/admin/", "destination": "/api/admin" },
    { "source": "/admin/chat", "destination": "/api/admin/chat" },
    { "source": "/admin/chat/", "destination": "/api/admin/chat" },
    { "source": "/admin/status", "destination": "/api/admin/status" },
    { "source": "/admin/status/", "destination": "/api/admin/status" },
    { "source": "/admin/sns-post", "destination": "/api/admin/sns-post" },
    { "source": "/admin/sns-post/", "destination": "/api/admin/sns-post" },
    { "source": "/admin/gubble-sns", "destination": "/api/admin/gubble-sns" },
    { "source": "/admin/gubble-sns/", "destination": "/api/admin/gubble-sns" },
    { "source": "/admin/admin-common.css", "destination": "/api/admin/common-css" },
    { "source": "/admin/sns-metrics.js", "destination": "/api/admin/gubble-sns-metrics" },
    { "source": "/ops", "destination": "/api/ops" },
    { "source": "/ops/", "destination": "/api/ops" },
    { "source": "/ops/prompts", "destination": "/api/ops/prompts" },
    { "source": "/ops/prompts/", "destination": "/api/ops/prompts" },
    { "source": "/ops/doc", "destination": "/api/ops/doc" },
    { "source": "/ops/doc/", "destination": "/api/ops/doc" },
    { "source": "/watch", "destination": "/watch/index.html" },
    { "source": "/watch/", "destination": "/watch/index.html" }
  ]
}
