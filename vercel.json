{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@5.1.6",
      "maxDuration": 60,
      "includeFiles": "site/static/admin/**"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/admin/", "destination": "/api/admin" }
  ]
}
