{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@5.1.6",
      "maxDuration": 60,
      "includeFiles": "{site/static/admin/**,content/consul-work/**}"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/admin/", "destination": "/api/admin" },
    { "source": "/admin/docs", "destination": "/api/admin/docs" },
    { "source": "/admin/docs/", "destination": "/api/admin/docs" },
    { "source": "/admin/chat", "destination": "/api/admin/chat" },
    { "source": "/admin/chat/", "destination": "/api/admin/chat" },
    { "source": "/watch", "destination": "/watch/index.html" },
    { "source": "/watch/", "destination": "/watch/index.html" }
  ]
}
