{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@5.1.6",
      "maxDuration": 60,
      "includeFiles": "{site/static/admin/**,site/static/ops/**,content/consul-work/**,outputs/agents_status.json,supabase/migrations/**}"
    }
  },
  "redirects": [
    {
      "source": "/lectures/2026-05-claude-code-features.html",
      "destination": "/lectures/2026-04-ai-kihon.html#codex-beginner",
      "permanent": true
    },
    { "source": "/admin/docs", "destination": "/ops", "permanent": false },
    { "source": "/admin/docs/", "destination": "/ops", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin/command-center", "destination": "/api/admin/command-center-page" },
    { "source": "/admin/command-center/", "destination": "/api/admin/command-center-page" },
    { "source": "/admin/command-center/calendar", "destination": "/api/admin/command-center-page?view=calendar" },
    { "source": "/admin/command-center/tasks", "destination": "/api/admin/command-center-page?view=tasks" },
    { "source": "/admin/command-center/businesses", "destination": "/api/admin/command-center-page?view=businesses" },
    { "source": "/admin/command-center/directives", "destination": "/api/admin/command-center-page?view=directives" },
    { "source": "/admin/command-center/studio", "destination": "/api/admin/command-center-page?view=studio" },
    { "source": "/admin/command-center/tools", "destination": "/api/admin/command-center-page?view=tools" },
    { "source": "/admin/command-center/trade", "destination": "/api/admin/command-center-page?view=trade" },
    { "source": "/admin/command-center/:view", "destination": "/api/admin/command-center-page?view=:view" },
    { "source": "/admin/command-center/:view/", "destination": "/api/admin/command-center-page?view=:view" },
    { "source": "/admin/command-center.css", "destination": "/api/admin/command-center-asset?file=css" },
    { "source": "/admin/command-center.js", "destination": "/api/admin/command-center-asset?file=js" },
    { "source": "/api/admin/command-center/data", "destination": "/api/admin/command-center-data" },
    { "source": "/api/admin/command-center/calendar", "destination": "/api/admin/command-center-calendar" },
    { "source": "/api/admin/command-center/market", "destination": "/api/admin/command-center-market" },
    { "source": "/api/admin/command-center/brief", "destination": "/api/admin/command-center-brief" },
    { "source": "/api/admin/command-center/rankings", "destination": "/api/admin/command-center-rankings" },
    { "source": "/api/admin/command-center/migrate", "destination": "/api/admin/command-center-migrate" },
    { "source": "/api/admin/command-center/relay", "destination": "/api/admin/command-center-relay" },
    { "source": "/admin/login", "destination": "/api/admin/login" },
    { "source": "/admin/login/", "destination": "/api/admin/login" },
    { "source": "/admin/logout", "destination": "/api/admin/logout" },
    { "source": "/admin/logout/", "destination": "/api/admin/logout" },
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/admin/", "destination": "/api/admin" },
    { "source": "/admin/blog", "destination": "/api/admin/blog" },
    { "source": "/admin/blog/", "destination": "/api/admin/blog" },
    { "source": "/admin/blog/:section", "destination": "/api/admin/blog" },
    { "source": "/admin/blog/:section/", "destination": "/api/admin/blog" },
    { "source": "/admin/apps/reel", "destination": "/api/admin/apps/reel" },
    { "source": "/admin/apps/reel/", "destination": "/api/admin/apps/reel" },
    { "source": "/admin/apps/reel.html", "destination": "/api/admin/apps/reel" },
    { "source": "/admin/apps/:asset", "destination": "/api/admin/apps/asset?file=:asset" },
    { "source": "/admin/chat", "destination": "/api/admin/chat" },
    { "source": "/admin/chat/", "destination": "/api/admin/chat" },
    { "source": "/admin/sns-post", "destination": "/api/admin/sns-post" },
    { "source": "/admin/sns-post/", "destination": "/api/admin/sns-post" },
    { "source": "/admin/gubble-sns", "destination": "/api/admin/gubble-sns" },
    { "source": "/admin/gubble-sns/", "destination": "/api/admin/gubble-sns" },
    { "source": "/admin/admin-common.css", "destination": "/api/admin/common-css" },
    { "source": "/admin/admin-menu.js", "destination": "/api/admin/menu-js" },
    { "source": "/admin/sns-metrics.js", "destination": "/api/admin/gubble-sns-metrics" },
    { "source": "/ops", "destination": "/api/ops" },
    { "source": "/ops/", "destination": "/api/ops" },
    { "source": "/ops/prompts", "destination": "/api/ops/prompts" },
    { "source": "/ops/prompts/", "destination": "/api/ops/prompts" },
    { "source": "/ops/doc", "destination": "/api/ops/doc" },
    { "source": "/ops/doc/", "destination": "/api/ops/doc" },
    { "source": "/watch", "destination": "/watch/index.html" },
    { "source": "/watch/", "destination": "/watch/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/speed-monitor-watchdog", "schedule": "0 */3 * * *" }
  ]
}
